{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload ESP32-S3 voice firmware",
      "type": "process",
      "command": "${env:HOME}/.platformio/penv/bin/platformio",
      "args": [
        "run",
        "--project-dir",
        "${workspaceFolder}/voice_firmware",
        "--environment",
        "esp32-s3-voice",
        "--target",
        "upload"
      ],
      "problemMatcher": []
    }
  ]
}
